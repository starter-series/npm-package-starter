{
  "name": "my-package",
  "version": "0.1.0",
  "description": "A lightweight npm package with CI/CD baked in.",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "node scripts/verify-package.js",
    "lint": "eslint src/ tests/ scripts/",
    "test": "jest --verbose --coverage",
    "pack:check": "node scripts/verify-pack.js",
    "check:metadata": "node scripts/check-metadata.js",
    "prepublishOnly": "npm run check:metadata && npm run build && npm run pack:check",
    "version:patch": "node scripts/bump-version.js patch",
    "version:minor": "node scripts/bump-version.js minor",
    "version:major": "node scripts/bump-version.js major"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_USERNAME/YOUR_PACKAGE.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.5.0",
    "globals": "^17.7.0",
    "jest": "^30.3.0",
    "license-checker-evergreen": "^6.3.1"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.js",
      "scripts/**/*.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 95,
        "branches": 95,
        "functions": 95,
        "lines": 95
      }
    },
    "coverageReporters": [
      "text",
      "text-summary",
      "json-summary"
    ]
  }
}
